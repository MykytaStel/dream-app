# Copy to .env and fill in. .env is gitignored; this file is not.

# Crash reporting. Leave empty to disable it entirely — the app then logs to the
# console provider and behaves exactly as it did before Sentry was added.
# Found in Sentry under Settings, Projects, <project>, Client Keys (DSN).
SENTRY_DSN=

# Optional cloud sync. The app ships with a working project baked in
# (see src/config/cloud.ts); these override it, and can also be set at runtime
# from the in-app settings screen.
SUPABASE_URL=
SUPABASE_ANON_KEY=
