# Copy to .env and fill in. .env is gitignored; this file is not.

# Crash reporting. The project DSN is bundled (src/services/observability/
# sentryObservability.ts) so release builds report without any env setup, and
# dev builds never report. Set this to override the bundled DSN, or to an empty
# string to force crash reporting off. Found in Sentry under Settings, Projects,
# <project>, Client Keys (DSN).
SENTRY_DSN=

# Optional cloud sync. The app ships with a working project baked in
# (see src/config/cloud.ts); these override it, and can also be set at runtime
# from the in-app settings screen.
SUPABASE_URL=
SUPABASE_ANON_KEY=
