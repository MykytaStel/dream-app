{
	"compilerOptions": {
		"jsx": "react",
		// The base config narrows this to ["jest"]; tests that read project
		// files — the Android backup rules, for one — need node's fs and path.
		"types": ["jest", "node"]
	},
  "extends": "@react-native/typescript-config",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods", "v0"]
}
